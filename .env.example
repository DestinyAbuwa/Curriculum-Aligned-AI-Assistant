# Copy this file to .env and fill in real values. Never commit .env.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
TAVILY_API_KEY=
# Only needed for `langgraph dev` (LangGraph Studio). Free LangSmith account.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
# Optional overrides (defaults shown)
# LLM_PROVIDER=openai   # default; set to 'ollama' to use the local model instead
# OPENAI_MODEL=gpt-6-luna
# OLLAMA_MODEL=qwen3:8b   # only used when LLM_PROVIDER=ollama
# CHROMA_PATH=
# RETRIEVAL_K=5
# MAX_DISTANCE=0.50
