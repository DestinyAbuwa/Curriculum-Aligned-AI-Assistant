# Copy this file to .env and fill in real values. Never commit .env.

OPENAI_API_KEY=
# Optional; required if Hugging Face prompts for gated MedGemma access.
HF_TOKEN=
ANTHROPIC_API_KEY=
TAVILY_API_KEY=
# Only needed for `langgraph dev` (LangGraph Studio). Free LangSmith account.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
# Optional overrides (defaults shown)
# LLM_PROVIDER=openai   # default; set to 'mlx' to use local MedGemma on Apple Silicon
# OPENAI_MODEL=gpt-6-luna
# MLX_MODEL=mlx-community/medgemma-4b-it-4bit   # only used when LLM_PROVIDER=mlx
# CHROMA_PATH=
# RETRIEVAL_K=5
# MAX_DISTANCE=0.50
# IMAGE_MAX_DISTANCE=0.45
# IMAGE_MARGIN=0.05
